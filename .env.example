# Copie para .env.local (local) e cadastre as mesmas variáveis na Vercel.
# Chave da OpenRouter (só no servidor).
OPENROUTER_API_KEY=
# Código que o app pede uma vez em cada aparelho.
APP_ACCESS_CODE=
# Supabase: URL do projeto e chave secreta (sb_secret_... ou service_role).
SUPABASE_URL=https://rqvhnsjfhfqzykhwvcks.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: modelo da OpenRouter (padrão google/gemini-2.5-flash).
OPENROUTER_MODEL=
